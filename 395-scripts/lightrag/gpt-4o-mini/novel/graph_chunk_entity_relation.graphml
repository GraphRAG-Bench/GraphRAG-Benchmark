      <data key="d6" />
    </node>
    <node id="Kettle">
      <data key="d0">Kettle</data>
      <data key="d1">artifact</data>
      <data key="d2">The kettle is a polished item in the kitchen that sings and interacts with the fire, expressing pride in its appearance.&lt;SEP&gt;The Kettle is an inanimate object that is anthropomorphized and plays a role in the dialogue about helping others.</data>
