    <node id="Almanzor">
      <data key="d0">Almanzor</data>
      <data key="d1">person</data>
      <data key="d2">Almanzor was a famous Sultan who intended for Rabat to be his capital and expelled the Moravedi from Spain.</data>
      <data key="d3">chunk-c02e1fb091464c03ab00842920bc21f1</data>
      <data key="d4">unknown_source</data>
