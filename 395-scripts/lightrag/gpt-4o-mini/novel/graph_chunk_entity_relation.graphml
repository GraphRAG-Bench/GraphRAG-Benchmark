      <data key="d0">Samuel Lount</data>
      <data key="d1">person</data>
      <data key="d2">Samuel Lount is referenced as a figure who was hanged for rebellion in Upper Canada.</data>
      <data key="d3">chunk-1d3c806038738c5cf824708ed3cfff5e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763622253</data>
