    <node id="Lord Brougham">
      <data key="d0">Lord Brougham</data>
      <data key="d1">person</data>
      <data key="d2">Lord Brougham is identified as a critic of Durham's decisions regarding the rebels and prisoners.&lt;SEP&gt;Lord Brougham is associated with legislation on abolition, specifically referenced in the Anti-slavery circular.</data>
      <data key="d3">chunk-1d3c806038738c5cf824708ed3cfff5e&lt;SEP&gt;chunk-4bc0fa20a8bb60c2f53107ccd7d2bbec</data>
