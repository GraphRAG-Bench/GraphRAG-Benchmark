      <data key="d1">person</data>
      <data key="d2">Julian Schmidt authored several works including "Bilder aus dem geistigen Leben unserer Zeit" published in Leipzig in 1870 and "Geschichte der deutschen Litteratur von Leibnitz bis auf unsere Zeit," published in Berlin between 1886-96.</data>
      <data key="d3">chunk-b00bff87303bf89315a4f5f9c478e3b5</data>
      <data key="d4">unknown_source</data>
