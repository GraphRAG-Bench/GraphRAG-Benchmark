    <node id="Ur">
      <data key="d0">Ur</data>
      <data key="d1">location</data>
      <data key="d2">Ur is an ancient city believed to be the capital of the Chaldeans during the time of Abraham, associated with moon worship.&lt;SEP&gt;Ur is an ancient city associated with Bel-Zuna, reflecting its historical significance in architecture.</data>
      <data key="d3">chunk-965b5b39cb58a29f56a43495ef18b6ff&lt;SEP&gt;chunk-80579f75badf4bd09adb3a115b482e00</data>
