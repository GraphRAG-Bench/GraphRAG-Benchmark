      <data key="d1">content</data>
      <data key="d2">Soda soap is compared unfavorably to potash soap, particularly in its effectiveness for washing wool and textiles.</data>
      <data key="d3">chunk-4e3baf81033bb4ebaf7b3fd82e4c171e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763624051</data>
