    <node id="Peking">
      <data key="d0">Peking</data>
      <data key="d1">location</data>
      <data key="d2">Peking is a historical city in China where significant ancient relics and stone instruments, such as the _tse-king_, are found in temples dedicated to Confucius.</data>
      <data key="d3">chunk-b0d3d720b9e8db10b828dd12d97de70e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763625997</data>
