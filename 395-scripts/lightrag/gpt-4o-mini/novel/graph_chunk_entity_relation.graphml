      <data key="d1">person</data>
      <data key="d2">Omar Ei-Haj is identified as the best gunner among the Moors who dies during the bombardment, affecting their morale.</data>
      <data key="d3">chunk-1c246ad7923d08e2ef2366af23b4c19f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763626564</data>
      <data key="d6" />
    </node>
    <node id="European Jews">
