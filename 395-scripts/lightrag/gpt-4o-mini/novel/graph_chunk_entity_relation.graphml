      <data key="d0">Canadas</data>
      <data key="d1">location</data>
      <data key="d2">The Canadas refers to the historical regions in North America that were part of British colonial governance.</data>
      <data key="d3">chunk-3fa1b94cc88676d252f09238e9d2fcd2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763622255</data>
