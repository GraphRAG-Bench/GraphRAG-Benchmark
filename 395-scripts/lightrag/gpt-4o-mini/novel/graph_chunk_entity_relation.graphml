    <node id="The Squirrel">
      <data key="d0">The Squirrel</data>
      <data key="d1">creature</data>
      <data key="d2">The Squirrel is a character that assists the grandmother and performs small tasks for her.&lt;SEP&gt;The Squirrel is an observer who attempts to follow directions on jumping and gives a humorous commentary during the dance.&lt;SEP&gt;The Squirrel participates in the conversation and shows skepticism towards the explanation given about the term "low."</data>
      <data key="d3">chunk-6f7adebfdec41855a49926f0ef0c9df6&lt;SEP&gt;chunk-b60d4926e5d4ac6ded55aa7e91fca4c3&lt;SEP&gt;chunk-6778bb1c4c17f23f0cc54a25751bc2f8</data>
