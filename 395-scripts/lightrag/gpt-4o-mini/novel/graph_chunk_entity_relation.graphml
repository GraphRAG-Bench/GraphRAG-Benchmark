    <node id="Perspiration Tubes">
      <data key="d0">Perspiration Tubes</data>
      <data key="d1">concept</data>
      <data key="d2">Perspiration tubes are channels in the skin through which waste matter is expelled as perspiration, critical for skin health and cleanliness.</data>
      <data key="d3">chunk-306d5de2eae0665c92137b63fb6d96d3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763624492</data>
