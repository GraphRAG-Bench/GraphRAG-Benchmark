      <data key="d4">unknown_source</data>
      <data key="d5">1763624051</data>
      <data key="d6" />
    </node>
    <node id="Grease">
      <data key="d0">Grease</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Grease can substitute for tallow in soap-making, providing a source of fat for the soap.</data>
