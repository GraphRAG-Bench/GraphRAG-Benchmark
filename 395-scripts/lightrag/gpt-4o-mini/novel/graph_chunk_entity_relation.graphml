      <data key="d0">George H. Colgrave</data>
      <data key="d1">person</data>
      <data key="d2">George H. Colgrave designed the beautiful floats for the parade and is associated with the Pioneer Press Company.</data>
      <data key="d3">chunk-d26c30cc3102d9679f3880d6b7c95b61</data>
      <data key="d4">unknown_source</data>
