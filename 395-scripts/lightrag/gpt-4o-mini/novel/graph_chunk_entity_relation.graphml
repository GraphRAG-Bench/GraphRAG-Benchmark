      <data key="d1">person</data>
      <data key="d2">James Calton is Chris's brother who interacts with Miss Trotter regarding the situation with Mr. Bilson and Chris.</data>
      <data key="d3">chunk-369a75ce4a9aaf2cf4882dd927c2352f</data>
      <data key="d4">unknown_source</data>
