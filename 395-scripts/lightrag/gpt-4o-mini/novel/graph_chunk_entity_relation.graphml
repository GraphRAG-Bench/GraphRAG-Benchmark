    <node id="Bone">
      <data key="d0">Bone</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Bones are the rigid structures in the body that require nutrients to grow and repair, which can be supplied by food.</data>
      <data key="d3">chunk-476f39fcc8c0c7619821c2b1143970d6</data>
