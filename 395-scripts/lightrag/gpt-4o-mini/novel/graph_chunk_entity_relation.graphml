    <node id="Ajacaxtli">
      <data key="d0">Ajacaxtli</data>
      <data key="d1">artifact</data>
      <data key="d2">Ajacaxtli is a traditional rattle used by Mexicans, typically made from gourds and filled with pebbles for sound.</data>
      <data key="d3">chunk-a423779aeb8c30b26de6eff15931f31c</data>
