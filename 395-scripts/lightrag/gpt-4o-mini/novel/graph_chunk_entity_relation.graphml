    <node id="Intermittent Fevers">
      <data key="d0">Intermittent Fevers</data>
      <data key="d1">concept</data>
      <data key="d2">Intermittent fevers are mentioned as a health issue prevalent in Yucatan, influenced by environmental factors.</data>
      <data key="d3">chunk-a838c08843884c0f3a0816d2b39bddaf</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763619819</data>
