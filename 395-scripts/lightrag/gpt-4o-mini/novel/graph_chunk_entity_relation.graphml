      <data key="d0">Tse-King</data>
      <data key="d1">artifact</data>
      <data key="d2">The _tse-king_ is a single sonorous stone used as a rhythmical instrument in Chinese music.</data>
      <data key="d3">chunk-b0d3d720b9e8db10b828dd12d97de70e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763625997</data>
