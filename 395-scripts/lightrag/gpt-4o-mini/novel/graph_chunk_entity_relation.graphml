    <node id="Treaty">
      <data key="d0">Treaty</data>
      <data key="d1">concept</data>
      <data key="d2">The Treaty is the formal agreement between Britain and Morocco that includes stipulations on the treatment of British subjects in Morocco.</data>
      <data key="d3">chunk-f9af5b64614e29079b8b6802af2587be</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763626568</data>
