    </node>
    <node id="Eyes">
      <data key="d0">Eyes</data>
      <data key="d1">naturalobject</data>
      <data key="d2">The eyes are organs involved in vision, containing pupils that adjust size based on light conditions.</data>
      <data key="d3">chunk-306d5de2eae0665c92137b63fb6d96d3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763624491</data>
