      <data key="d0">Magnetic Telegraph</data>
      <data key="d1">concept</data>
      <data key="d2">The Magnetic Telegraph represents significant technological progress in communication during the 19th century.</data>
      <data key="d3">chunk-ddd4a502deaa5a3c805ab90de493f313</data>
