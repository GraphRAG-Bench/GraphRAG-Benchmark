      <data key="d0">Legislature of Lower Canada</data>
      <data key="d1">organization</data>
      <data key="d2">The Legislature of Lower Canada is the political assembly where Lord Gosford announced his policies.</data>
      <data key="d3">chunk-f63400d8188502b67eda00c561659eb8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763622255</data>
