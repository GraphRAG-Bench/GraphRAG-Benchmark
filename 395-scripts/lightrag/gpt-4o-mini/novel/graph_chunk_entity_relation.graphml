    <node id="Numidians">
      <data key="d0">Numidians</data>
      <data key="d1">people</data>
      <data key="d2">Numidians are ancient tribes from North Africa, associated with regions that include modern-day Tunisia and Algeria, known for their conflicts and interactions with Romans.</data>
      <data key="d3">chunk-73f52bfe54d47067a25b5b0c44706763</data>
      <data key="d4">unknown_source</data>
