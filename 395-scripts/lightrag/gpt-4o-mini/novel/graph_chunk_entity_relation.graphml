    <node id="Abdullah-el-Kamel">
      <data key="d0">Abdullah-el-Kamel</data>
      <data key="d1">person</data>
      <data key="d2">Abdullah-el-Kamel, known as "The Perfect," was a father of Edris and a significant figure in the genealogy of Moroccan dynasties.</data>
