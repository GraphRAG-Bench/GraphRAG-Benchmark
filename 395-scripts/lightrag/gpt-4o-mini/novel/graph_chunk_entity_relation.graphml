      <data key="d0">Taboulaunt</data>
      <data key="d1">location</data>
      <data key="d2">Taboulaunt is a village across the river Omm-Erbegh from Bulawan, predominantly inhabited by Jews and ferrymen.</data>
      <data key="d3">chunk-11883b983a6b12419bdd608231cd321f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763626566</data>
      <data key="d6" />
    </node>
