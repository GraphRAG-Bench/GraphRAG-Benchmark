      <data key="d6" />
    </node>
    <node id="Mr. Fleming">
      <data key="d0">Mr. Fleming</data>
      <data key="d1">person</data>
      <data key="d2">Mr. Fleming is a character associated with prospecting, engaged to Tinka Jallinger after revealing gold.</data>
      <data key="d3">chunk-9c87d89cd1180b8d6a006229057edd6c</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763625202</data>
      <data key="d6" />
    </node>
