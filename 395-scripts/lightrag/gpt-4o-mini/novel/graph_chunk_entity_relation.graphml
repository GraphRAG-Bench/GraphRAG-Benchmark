    <node id="Tetuan">
      <data key="d0">Tetuan</data>
      <data key="d1">location</data>
      <data key="d2">Tetuan is a well-known town on the Mediterranean coast of Morocco.&lt;SEP&gt;Tetuan is a large, rich, and mercantile city of the province of Hasbat, with a significant and diverse population.</data>
