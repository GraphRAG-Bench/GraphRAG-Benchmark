    <node id="American Aristocracy">
      <data key="d0">American Aristocracy</data>
      <data key="d1">concept</data>
      <data key="d2">The American aristocracy refers to a class of wealthy individuals in the United States during the nineteenth century who differ from European aristocracy in their historical lineage and social status.</data>
      <data key="d3">chunk-01da3252de63d3437b7317d570944a2c</data>
