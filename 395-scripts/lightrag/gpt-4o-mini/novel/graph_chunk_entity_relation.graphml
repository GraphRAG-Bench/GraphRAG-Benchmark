      <data key="d0">Catholic Clergy</data>
      <data key="d1">group</data>
      <data key="d2">The Catholic clergy is referenced as a group that initially supported Papineau but began to withdraw support.</data>
      <data key="d3">chunk-3fa1b94cc88676d252f09238e9d2fcd2</data>
      <data key="d4">unknown_source</data>
