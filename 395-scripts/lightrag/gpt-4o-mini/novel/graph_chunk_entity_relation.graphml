    </node>
    <node id="Little-Sis">
      <data key="d0">Little-Sis</data>
      <data key="d1">person</data>
      <data key="d2">Little-Sis is Cæsar Simon's younger sister, who also attempted to care for him and taught him lessons after Big-Sis.</data>
      <data key="d3">chunk-01da3252de63d3437b7317d570944a2c</data>
      <data key="d4">unknown_source</data>
