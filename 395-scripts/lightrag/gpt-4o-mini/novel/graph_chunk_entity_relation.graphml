    <node id="Chayna">
      <data key="d0">Chayna</data>
      <data key="d1">artifact</data>
      <data key="d2">Chayna is described as a flute with a melancholic sound, known to evoke sadness, potentially an oboe-like instrument.</data>
      <data key="d3">chunk-4fea727469cc8526b5cd257ed6247a09</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763625996</data>
