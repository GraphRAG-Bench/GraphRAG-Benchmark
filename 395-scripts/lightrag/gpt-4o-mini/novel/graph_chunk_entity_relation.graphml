      <data key="d0">Nai-Ping</data>
      <data key="d1">person</data>
      <data key="d2">Nai-Ping is the second priest of the Saki-Pan, responsible for temple duties and interacts with Chop-Chin.</data>
      <data key="d3">chunk-d1c80cac977c30ca82e1b9af698fb201</data>
      <data key="d4">unknown_source</data>
