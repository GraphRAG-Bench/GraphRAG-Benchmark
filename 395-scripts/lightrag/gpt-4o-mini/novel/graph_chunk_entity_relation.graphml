    <node id="Forts">
      <data key="d0">Forts</data>
      <data key="d1">artifact</data>
      <data key="d2">The forts in Rabat were erected by an English renegade and serve as defense structures against maritime threats.</data>
      <data key="d3">chunk-c02e1fb091464c03ab00842920bc21f1</data>
