    <node id="Intestines">
      <data key="d0">Intestines</data>
      <data key="d1">naturalobject</data>
      <data key="d2">The intestines are a long, coiled tube that processes food from the stomach, leading to nutrient absorption into the blood.</data>
      <data key="d3">chunk-476f39fcc8c0c7619821c2b1143970d6</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763624493</data>
      <data key="d6" />
