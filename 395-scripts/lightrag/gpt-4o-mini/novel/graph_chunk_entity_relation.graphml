    <node id="Azamor">
      <data key="d0">Azamor</data>
      <data key="d1">location</data>
      <data key="d2">Azamor is an ancient city built by the Amazigh Berbers, known for its salmon commerce and historical significance with Portuguese occupation.&lt;SEP&gt;Azamor is a location that was fortified by the Portuguese in 1513 but was abandoned in 1769 due to changing trade dynamics.</data>
      <data key="d3">chunk-c02e1fb091464c03ab00842920bc21f1&lt;SEP&gt;chunk-284546e32da930f297907ef0f48339cc</data>
