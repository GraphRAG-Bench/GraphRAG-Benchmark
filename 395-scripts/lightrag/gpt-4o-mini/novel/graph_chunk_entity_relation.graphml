    <node id="Refraction Table">
      <data key="d0">Refraction Table</data>
      <data key="d1">data</data>
      <data key="d2">The Refraction Table provides data on atmospheric refraction based on altitude within the latitude of the United States.&lt;SEP&gt;A refraction table provides data to correct for the atmospheric refraction effect on observed altitudes.</data>
      <data key="d3">chunk-542ef42b55daca6f5424b791e6bd2765&lt;SEP&gt;chunk-ac7ddc2e019049a9912f840df02ad08a</data>
      <data key="d4">unknown_source</data>
