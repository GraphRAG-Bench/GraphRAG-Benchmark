      <data key="d0">Pioneer Printing Company</data>
      <data key="d1">organization</data>
      <data key="d2">The Pioneer Printing Company contributed an exhibit in the parade showcasing printers and printing through history.</data>
      <data key="d3">chunk-d26c30cc3102d9679f3880d6b7c95b61</data>
      <data key="d4">unknown_source</data>
