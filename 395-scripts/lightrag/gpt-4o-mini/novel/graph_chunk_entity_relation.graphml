    </node>
    <node id="American Newspaper">
      <data key="d0">American Newspaper</data>
      <data key="d1">content</data>
      <data key="d2">An American newspaper is mentioned as the medium through which news of the disallowance reached Durham.</data>
      <data key="d3">chunk-1d3c806038738c5cf824708ed3cfff5e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763622254</data>
      <data key="d6" />
    </node>
    <node id="Patriote Party">
      <data key="d0">Patriote Party</data>
      <data key="d1">organization</data>
      <data key="d2">The Patriote Party is a political party in Lower Canada that sought to address the interests of French Canadians during a time of political turmoil.&lt;SEP&gt;The Patriote Party is a political party advocating for reforms such as an elective Legislative Council, led by Papineau.&lt;SEP&gt;The Patriote Party is a political group in Canada that opposed colonial governance and supported the Ninety-Two Resolutions.&lt;SEP&gt;The Patriote Party was a political group advocating for the emancipation of Canada from British authority in the early 19th century.</data>
      <data key="d3">chunk-fe367bc72a82be3c2cacfc81ba72e719&lt;SEP&gt;chunk-3fa1b94cc88676d252f09238e9d2fcd2&lt;SEP&gt;chunk-ba0f247b33f556371c343cbd158638c2&lt;SEP&gt;chunk-1fc668a337064f7982e9ba35184cf528</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763622254</data>
      <data key="d6" />
    </node>
