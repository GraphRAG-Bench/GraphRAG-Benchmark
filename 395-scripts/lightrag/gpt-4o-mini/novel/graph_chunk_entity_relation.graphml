    <node id="Moravedi">
      <data key="d0">Moravedi</data>
      <data key="d1">person</data>
      <data key="d2">Moravedi refers to the Marabouts dynasty that began in 1050 and ended in 1149.&lt;SEP&gt;The Moravedi were expelled from Spain by Sultan Almanzor.</data>
