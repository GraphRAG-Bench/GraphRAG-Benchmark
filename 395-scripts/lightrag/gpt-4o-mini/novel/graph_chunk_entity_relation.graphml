    <node id="Cotton Plant">
      <data key="d0">Cotton Plant</data>
      <data key="d1">naturalobject</data>
      <data key="d2">The cotton plant is an agricultural crop that became central to economies in the Southern States during the nineteenth century.</data>
      <data key="d3">chunk-01da3252de63d3437b7317d570944a2c</data>
