      <data key="d0">Early Boatmen Law</data>
      <data key="d1">concept</data>
      <data key="d2">The Early Boatmen Law is a historical guideline dictating how personal quarrels were settled among boatmen through physical fights.</data>
      <data key="d3">chunk-029587962a0e769bf41beb4d2b181466</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763624330</data>
