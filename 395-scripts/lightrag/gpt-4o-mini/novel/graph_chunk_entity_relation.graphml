    </node>
    <node id="Truxillo">
      <data key="d0">Truxillo</data>
      <data key="d1">location</data>
      <data key="d2">Truxillo is a location where bone-flutes were disinterred and documented in archaeological findings related to ancient Peru.</data>
      <data key="d3">chunk-4fea727469cc8526b5cd257ed6247a09</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763625996</data>
