      <data key="d0">Fairy Story</data>
      <data key="d1">content</data>
      <data key="d2">The Fairy Story is a tale involving magical beings that the good hermit agrees to tell, inspired by Eileen's request.</data>
      <data key="d3">chunk-63e172b463b651297a4b51743b0d92c2</data>
