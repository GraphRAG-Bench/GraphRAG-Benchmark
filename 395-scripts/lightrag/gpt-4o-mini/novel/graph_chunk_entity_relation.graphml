      <data key="d0">Third United States Dragoons</data>
      <data key="d1">militaryunit</data>
      <data key="d2">The Third United States Dragoons were the unit that Capt. E.Y. Shelly served with during the Mexican War and later in the Civil War.</data>
      <data key="d3">chunk-2a4789d4f1f7c874d43ac8b35b4ece9b</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763622768</data>
      <data key="d6" />
    </node>
    <node id="Fort Donelson">
      <data key="d0">Fort Donelson</data>
      <data key="d1">location</data>
      <data key="d2">Fort Donelson is the site where Brackett's Battalion took part in an important engagement during the Civil War.&lt;SEP&gt;Fort Donelson is a historical site involved in significant Civil War battles, including engagements with rebel forces.&lt;SEP&gt;Fort Donelson was another fortification associated with Gen. Grant's early successes.</data>
      <data key="d3">chunk-2a4789d4f1f7c874d43ac8b35b4ece9b&lt;SEP&gt;chunk-078fa88c408ca99e058ba3c5129a1858&lt;SEP&gt;chunk-501e774a64f7a58c082acf7597c0a211</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763622768</data>
      <data key="d6" />
    </node>
    <node id="Ditmarth">
      <data key="d0">Ditmarth</data>
      <data key="d1">person</data>
      <data key="d2">Ditmarth is noted as one of the first young printers to set foot in the site of early St. Paul, Minnesota.</data>
