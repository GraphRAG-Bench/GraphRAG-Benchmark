    <node id="Gen. Price">
      <data key="d0">Gen. Price</data>
      <data key="d1">person</data>
      <data key="d2">Gen. Price is a military leader who managed an army during the war in Missouri, ensuring they were not demoralized despite lacking resources.</data>
