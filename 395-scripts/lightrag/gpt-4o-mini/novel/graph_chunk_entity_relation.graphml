    </node>
    <node id="John Inglis">
      <data key="d0">John Inglis</data>
      <data key="d1">person</data>
      <data key="d2">John Inglis, the second youngest son of David and Martha Inglis, was born in 1820 and later became a student at Haileybury College.&lt;SEP&gt;John Inglis is the full name of Mr. Inglis, described as an upright and high principled Christian gentleman.</data>
      <data key="d3">chunk-c1f01e511989b4651de0b56333122230&lt;SEP&gt;chunk-2462ff70f1dbd30f8a4b0b4d73c23c58</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763620333</data>
