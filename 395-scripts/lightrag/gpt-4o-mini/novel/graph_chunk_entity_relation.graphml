      <data key="d0">Jews of the Oasis of Sahara</data>
      <data key="d1">group</data>
      <data key="d2">The Jews of the Oasis of Sahara are families living in relative freedom and independence, mentioned as a point of reference regarding Jewish communities in Africa.</data>
      <data key="d3">chunk-d4996254e95ccc6b78afba2bb6b96949</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763626566</data>
      <data key="d6" />
    </node>
    <node id="Tefza">
      <data key="d0">Tefza</data>
      <data key="d1">location</data>
      <data key="d2">Tefza is a town located two miles east of Efza, surrounded by a high wall of sandstone, known for its woolen manufactures.</data>
      <data key="d3">chunk-11883b983a6b12419bdd608231cd321f&lt;SEP&gt;chunk-78c973a4a4c99e07c3571a6d29d1779d</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763626566</data>
      <data key="d6" />
