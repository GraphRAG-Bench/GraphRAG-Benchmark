      <data key="d1">people</data>
      <data key="d2">The European Jews are mentioned as being particularly vulnerable during the attacks and chaos in Mogador.</data>
      <data key="d3">chunk-1c246ad7923d08e2ef2366af23b4c19f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763626564</data>
