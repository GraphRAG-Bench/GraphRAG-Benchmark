      <data key="d0">Haileybury College</data>
      <data key="d1">location</data>
      <data key="d2">Haileybury College is an educational institution in England where John Inglis studied and was recognized for his academic and athletic abilities.</data>
      <data key="d3">chunk-c1f01e511989b4651de0b56333122230</data>
      <data key="d4">unknown_source</data>
