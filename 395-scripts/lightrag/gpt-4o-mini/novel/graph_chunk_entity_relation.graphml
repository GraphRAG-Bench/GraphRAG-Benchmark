    <node id="Itzaes">
      <data key="d0">Itzaes</data>
      <data key="d1">organization</data>
      <data key="d2">The Itzaes are a group of Maya people known for their retreat to islands in Lake Peten after the invasion of the Nahualts.&lt;SEP&gt;The Itzaes were a group known for their civilization, characterized by their impressive architecture and devout beliefs.</data>
      <data key="d3">chunk-fa1a6047d3b960e8aa1f1e7a19add07e&lt;SEP&gt;chunk-a65e48b610f2a391366b1dc455dacc28</data>
