    <node id="Perseus">
      <data key="d0">Perseus</data>
      <data key="d1">person</data>
      <data key="d2">Perseus is the hero who slays the sea monster threatening Andromeda, as narrated in the Metamorphoses.&lt;SEP&gt;Perseus is a mythological hero and a descendant of Abas, known for rescuing Andromeda and slaying Medusa.</data>
      <data key="d3">chunk-a0dd004d7bb30cbae402f5f620fd614a&lt;SEP&gt;chunk-c2ae1d708e454e0e6bf3e72d6ca49fad</data>
