    <node id="Sugar Cane">
      <data key="d0">Sugar Cane</data>
      <data key="d1">crop</data>
      <data key="d2">Sugar cane is a crop cultivated in certain fertile areas of Yucatan, yielding significant quantities of starch.</data>
