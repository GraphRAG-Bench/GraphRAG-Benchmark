      <data key="d0">Calcutta</data>
      <data key="d1">location</data>
      <data key="d2">Calcutta is a city in India where John Inglis served as assistant magistrate and later engaged in various official responsibilities.</data>
      <data key="d3">chunk-c1f01e511989b4651de0b56333122230</data>
      <data key="d4">unknown_source</data>
