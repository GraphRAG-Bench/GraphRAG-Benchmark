      <data key="d0">Daily Democrat</data>
      <data key="d1">content</data>
      <data key="d2">The Daily Democrat is recognized as a newspaper that Capt. E.Y. Shelly was connected with after the Pioneer.</data>
      <data key="d3">chunk-2a4789d4f1f7c874d43ac8b35b4ece9b</data>
