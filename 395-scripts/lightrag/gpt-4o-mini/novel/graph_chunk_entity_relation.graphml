    <node id="Summit Hotel">
      <data key="d0">Summit Hotel</data>
      <data key="d1">organization</data>
      <data key="d2">Summit Hotel is the establishment where Miss Trotter works and is responsible for the conduct of the staff, including Frida Jansen.&lt;SEP&gt;The Summit Hotel is the establishment that Miss Trotter will manage following Mr. Bilson's marriage.</data>
      <data key="d3">chunk-369a75ce4a9aaf2cf4882dd927c2352f&lt;SEP&gt;chunk-1f2949837deae0d2af6b85bc72ecfa57</data>
