    </node>
    <node id="Treaty of Bassein">
      <data key="d0">Treaty of Bassein</data>
      <data key="d1">event</data>
      <data key="d2">The Treaty of Bassein was a significant agreement made in 1803 that involved territorial changes in India and greatly affected the balance of power among local principalities.</data>
      <data key="d3">chunk-c1f01e511989b4651de0b56333122230</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763620333</data>
