      <data key="d6" />
    </node>
    <node id="Ly-Chee">
      <data key="d0">Ly-Chee</data>
      <data key="d1">person</data>
      <data key="d2">Ly-Chee is Chop-Chin's father, a sweeper in the Imperial court whose duty is to keep the courtyard clean.&lt;SEP&gt;Ly-Chee is Chop-Chin's father and a sweeper responsible for keeping the Imperial court-yard clean.&lt;SEP&gt;Ly-Chee is a character described as having long and faithful service, facing execution as ordered by the Emperor.&lt;SEP&gt;Ly-Chee is a faithful servant who has brought fresh melons every Tuesday afternoon for thirty years and is condemned to death by the Emperor.&lt;SEP&gt;Ly-Chee is the Chief-Sweeper of the courtyard, who rides in a procession and is celebrated for his good fortune.</data>
      <data key="d3">chunk-3d3e57d404581a83d442385fc9e650dd&lt;SEP&gt;chunk-5dc6e32918330eb85b6be8174ed5395a&lt;SEP&gt;chunk-57350e9ef876aa02f2e4a0422b1ab48d&lt;SEP&gt;chunk-8f9814d06b58178385c8b7cffd803ce6&lt;SEP&gt;chunk-759c07b9e02ea8da79b447394f2f4c45</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763625586</data>
