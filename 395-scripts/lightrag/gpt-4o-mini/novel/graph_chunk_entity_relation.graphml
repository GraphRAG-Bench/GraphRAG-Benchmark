      <data key="d6" />
    </node>
    <node id="Press">
      <data key="d0">Press</data>
      <data key="d1">organization</data>
      <data key="d2">The Press is a newspaper that began full telegraphic reports in January 1861 and played a significant role in local news during the war.&lt;SEP&gt;The Press is a newspaper that started in 1861, indicating a shift in payment practices for employees in the industry.&lt;SEP&gt;The Press is a newspaper organization where the events unfold, involving various editors and reporters working in a newsroom environment.</data>
      <data key="d3">chunk-253bf03f6503d8e5da2098445ef9b630&lt;SEP&gt;chunk-c49b770a2f437d2a1478f52b0f2747ef&lt;SEP&gt;chunk-d8cf348102921436615f31eec7112c69</data>
