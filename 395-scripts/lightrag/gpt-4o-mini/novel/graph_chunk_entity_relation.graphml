    </node>
    <node id="Tchung">
      <data key="d0">Tchung</data>
      <data key="d1">artifact</data>
      <data key="d2">The _tchung_ is the Chinese name for bells, used historically to indicate time and contribute to musical performances.</data>
      <data key="d3">chunk-b0d3d720b9e8db10b828dd12d97de70e</data>
      <data key="d4">unknown_source</data>
