      <data key="d6" />
    </node>
    <node id="Confederate Troops">
      <data key="d0">Confederate Troops</data>
      <data key="d1">organization</data>
      <data key="d2">The Confederate Troops, comprising Generals McCulloch, Price, and Pearce, totaled about eleven thousand men and participated in battles against the Federal Troops.</data>
