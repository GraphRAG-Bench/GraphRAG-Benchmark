    </node>
    <node id="Clothes">
      <data key="d0">Clothes</data>
      <data key="d1">artifact</data>
      <data key="d2">Clothes worn next to the skin collect perspiration and worn-out particles, requiring proper care and airing for hygiene.</data>
      <data key="d3">chunk-306d5de2eae0665c92137b63fb6d96d3</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763624492</data>
