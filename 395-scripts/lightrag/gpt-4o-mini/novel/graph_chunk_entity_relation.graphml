    <node id="British Parliament">
      <data key="d0">British Parliament</data>
      <data key="d1">organization</data>
      <data key="d2">The British Parliament is the governing body that needs to approve certain actions in Canada and is referenced in the context of constitutional changes.</data>
      <data key="d3">chunk-f63400d8188502b67eda00c561659eb8</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763622254</data>
