    <node id="Mexican Gulf">
      <data key="d0">Mexican Gulf</data>
      <data key="d1">naturalobject</data>
      <data key="d2">The Mexican Gulf is a body of water surrounding Yucatan, contributing to the temperature and weather patterns of the region.</data>
      <data key="d3">chunk-a838c08843884c0f3a0816d2b39bddaf</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763619819</data>
      <data key="d6" />
    </node>
    <node id="Mangrove Forests">
      <data key="d0">Mangrove Forests</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Mangrove forests in Yucatan provide shelter for numerous sea birds and water fowls, enhancing biodiversity in the area.</data>
      <data key="d3">chunk-a838c08843884c0f3a0816d2b39bddaf</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763619819</data>
