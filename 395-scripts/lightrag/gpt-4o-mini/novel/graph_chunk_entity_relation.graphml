    <node id="Bone-Flutes">
      <data key="d0">Bone-Flutes</data>
      <data key="d1">artifact</data>
      <data key="d2">Bone-Flutes are musical instruments discovered in archaeological sites that were made from the bones of humans or animals and used in rituals.</data>
