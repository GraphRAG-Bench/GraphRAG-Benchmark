    <node id="Mistress">
      <data key="d0">Mistress</data>
      <data key="d1">person</data>
      <data key="d2">The mistress is the object of Noah Carter's affections, who prefers a wealthy rival over Noah.&lt;SEP&gt;The Mistress is a character described as a laundress who is kind and chattering while offering to dry the narrator and companions.</data>
      <data key="d3">chunk-24655aa74002f9c9a1716299b6bb40bc&lt;SEP&gt;chunk-2d4b3e608aee39b08d0a23ee7e08f470</data>
