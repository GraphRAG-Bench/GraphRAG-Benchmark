    <node id="Chief Sweeper">
      <data key="d0">Chief Sweeper</data>
      <data key="d1">concept</data>
      <data key="d2">The Chief Sweeper is a title given to Ly-Chee as part of the Golden Dragon's commands for life-long service.</data>
