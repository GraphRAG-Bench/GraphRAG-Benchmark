    </node>
    <node id="Tinka Jallinger">
      <data key="d0">Tinka Jallinger</data>
      <data key="d1">person</data>
      <data key="d2">Tinka Jallinger, short for Katinka, is a character who engages with John Fleming and refers to her father, Henry Boone Jallinger.&lt;SEP&gt;Tinka Jallinger is the daughter of a recluse hunter and becomes engaged to Jack after he borrows a prospecting pan.</data>
      <data key="d3">chunk-9c87d89cd1180b8d6a006229057edd6c&lt;SEP&gt;chunk-9cb9da5c2b7a4ec99cfef1dba35a808b</data>
      <data key="d4">unknown_source</data>
