    <node id="Pincullu">
      <data key="d0">Pincullu</data>
      <data key="d1">artifact</data>
      <data key="d2">Pincullu is identified as a type of flute used by ancient civilizations in ceremonial contexts.</data>
      <data key="d3">chunk-4fea727469cc8526b5cd257ed6247a09</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763625996</data>
