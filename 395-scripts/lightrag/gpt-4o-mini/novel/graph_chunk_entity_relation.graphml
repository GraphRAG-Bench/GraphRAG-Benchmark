    </node>
    <node id="Amazirghs">
      <data key="d0">Amazirghs</data>
      <data key="d1">people</data>
      <data key="d2">The Amazirghs are an ethnic group known for their civilization and independence, governing themselves with their own elders and chiefs.</data>
      <data key="d3">chunk-11883b983a6b12419bdd608231cd321f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763626566</data>
      <data key="d6" />
    </node>
    <node id="Ghuer">
      <data key="d0">Ghuer</data>
      <data key="d1">location</data>
      <data key="d2">Ghuer, or Gheu, is a strong rock citadel in Morocco, considered the most inaccessible, and serves as the residence of the supreme Amrgar of the Amazirghs.</data>
      <data key="d3">chunk-11883b983a6b12419bdd608231cd321f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763626566</data>
