      <data key="d0">Dimenet</data>
      <data key="d1">location</data>
      <data key="d2">Diment or Demnet is a considerable town populated by Shelouhs and Caraaite Jews, located in the district of Damnat.</data>
      <data key="d3">chunk-11883b983a6b12419bdd608231cd321f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763626566</data>
      <data key="d6" />
    </node>
    <node id="Aghmat">
      <data key="d0">Aghmat</data>
      <data key="d1">location</data>
      <data key="d2">Aghmat was once a thriving city and capital of Rhamna, now a decayed village at the foot of Mount Atlas.&lt;SEP&gt;Aghmat is a historical town located at the foot of Mount Atlas, known for its orchards and vineyards, and was the first capital of the Marabout dynasty.</data>
      <data key="d3">chunk-11883b983a6b12419bdd608231cd321f&lt;SEP&gt;chunk-67512ea13edfd2cab9973f3ae5f8c75d</data>
