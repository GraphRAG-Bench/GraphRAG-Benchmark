    <node id="Rinaldo">
      <data key="d0">Rinaldo</data>
      <data key="d1">person</data>
      <data key="d2">Rinaldo is identified as a gallant knight who dissolved the enchantment of the wood of Tasso, aiding the Crusaders in their efforts.</data>
