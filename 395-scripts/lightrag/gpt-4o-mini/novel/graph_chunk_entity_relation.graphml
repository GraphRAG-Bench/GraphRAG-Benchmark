    <node id="Azimuth Table">
      <data key="d0">Azimuth Table</data>
      <data key="d1">data</data>
      <data key="d2">The Azimuth Table provides calculated angles for various latitudes and years, assisting in navigational computations based on astronomical observations.&lt;SEP&gt;An azimuth table provides relevant data for determining the azimuth based on date and latitude.</data>
      <data key="d3">chunk-542ef42b55daca6f5424b791e6bd2765&lt;SEP&gt;chunk-1573d79bcfed29e4fb110ec5c56a26fb</data>
