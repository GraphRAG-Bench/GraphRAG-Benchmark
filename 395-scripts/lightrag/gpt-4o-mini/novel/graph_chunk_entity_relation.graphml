      <data key="d5">1763624330</data>
      <data key="d6" />
    </node>
    <node id="Federal Troops">
      <data key="d0">Federal Troops</data>
      <data key="d1">organization</data>
      <data key="d2">The Federal Troops, under Gen. Lyon, were nearly ten thousand strong and engaged in battles against the Confederate forces.</data>
      <data key="d3">chunk-db12a2e534724a0be9ade4aa8ff10a35</data>
      <data key="d4">unknown_source</data>
