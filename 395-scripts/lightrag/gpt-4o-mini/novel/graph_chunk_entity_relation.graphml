      <data key="d6" />
    </node>
    <node id="Marabout">
      <data key="d0">Marabout</data>
      <data key="d1">concept</data>
      <data key="d2">A Marabout is a title or degree used among the Muslim community, often associated with religious authority.&lt;SEP&gt;The Marabout is a religious figure whose curse is said to have affected the ancestors of the local villagers.</data>
      <data key="d3">chunk-680c330ee8036afcbacb673ce690b640&lt;SEP&gt;chunk-0fd702921e8d3a990c6c7e84369cba36</data>
