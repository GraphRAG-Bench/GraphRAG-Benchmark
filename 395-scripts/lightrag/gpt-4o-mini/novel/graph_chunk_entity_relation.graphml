      <data key="d0">Bulawan</data>
      <data key="d1">location</data>
      <data key="d2">Bulawan, also named Bou-el-Awan, is a small town with an old castle situated along the river Omm-Erbegh, important for its passage.</data>
      <data key="d3">chunk-11883b983a6b12419bdd608231cd321f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763626566</data>
      <data key="d6" />
