      <data key="d0">reincarnation</data>
      <data key="d1">concept</data>
      <data key="d2">Reincarnation is the belief in the cycle where souls return to inhabit new bodies based on their deeds in past lives.</data>
      <data key="d3">chunk-fa1a6047d3b960e8aa1f1e7a19add07e</data>
