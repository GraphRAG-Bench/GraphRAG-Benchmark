    <node id="Sheikh Tahib">
      <data key="d0">Sheikh Tahib</data>
      <data key="d1">person</data>
      <data key="d2">Sheikh Tahib is an individual who has experienced corporal punishment and collects tribute from the people.&lt;SEP&gt;Sheikh Tahib is a figure whose gardens were sold for 15,000 piastres, and whose wife contributed an additional 1,000.</data>
      <data key="d3">chunk-86994d5a5ba62d67eaecd5aaeeb5aab4&lt;SEP&gt;chunk-f1030072f07138e17f0700081a9158b4</data>
