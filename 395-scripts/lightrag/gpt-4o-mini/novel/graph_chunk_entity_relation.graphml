      <data key="d6" />
    </node>
    <node id="Rotunda">
      <data key="d0">Rotunda</data>
      <data key="d1">organization</data>
      <data key="d2">The Rotunda is a hospital in Dublin where Elsie intends to take a course in Midwifery.&lt;SEP&gt;The Rotunda is referenced as a hospital where students would live, highlighting Elsie's plans for her nursing work.&lt;SEP&gt;The Rotunda refers to a medical institution where the narrator has been learning and training.</data>
      <data key="d3">chunk-f4dc7c9f3044941df1985ca230c24ea3&lt;SEP&gt;chunk-4384d56f7f67884c58051b580bac6f58&lt;SEP&gt;chunk-2462ff70f1dbd30f8a4b0b4d73c23c58</data>
