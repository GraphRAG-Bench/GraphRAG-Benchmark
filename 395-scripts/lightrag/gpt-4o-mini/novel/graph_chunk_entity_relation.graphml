      <data key="d0">Floating Population</data>
      <data key="d1">concept</data>
      <data key="d2">The Floating Population refers to a transient group of woodcutters employed temporarily in wood yards, typically for cutting wood by the cord.</data>
      <data key="d3">chunk-029587962a0e769bf41beb4d2b181466</data>
      <data key="d4">unknown_source</data>
