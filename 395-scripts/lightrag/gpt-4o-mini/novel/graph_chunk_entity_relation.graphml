    <node id="King Sligo">
      <data key="d0">King Sligo</data>
      <data key="d1">person</data>
      <data key="d2">King Sligo is the monarch who devises a plan involving the treasure-chamber and seeks to identify a thief among his court.</data>
      <data key="d3">chunk-3f95c6e33fe89f14cf74854d84f63b54</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763625587</data>
