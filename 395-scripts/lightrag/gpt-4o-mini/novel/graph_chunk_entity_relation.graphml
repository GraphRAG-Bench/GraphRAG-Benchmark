    <node id="Sultan of Morocco">
      <data key="d0">Sultan of Morocco</data>
      <data key="d1">person</data>
      <data key="d2">The Sultan of Morocco is portrayed as a ruler whose justice may not align with European standards due to cultural differences and power dynamics.</data>
