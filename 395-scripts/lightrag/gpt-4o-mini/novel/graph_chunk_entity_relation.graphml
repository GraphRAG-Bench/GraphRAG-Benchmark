      <data key="d0">Soubeit</data>
      <data key="d1">location</data>
      <data key="d2">Soubeit is an ancient city on the left bank of the Omm-Erbegh, situated in a mountainous region noted for its hares.</data>
      <data key="d3">chunk-11883b983a6b12419bdd608231cd321f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763626566</data>
