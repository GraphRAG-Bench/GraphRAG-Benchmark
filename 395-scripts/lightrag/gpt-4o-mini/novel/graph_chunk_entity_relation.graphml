    </node>
    <node id="Steam">
      <data key="d0">Steam</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Steam is water vapor that is formed when water boils and can be used in the distillation process to separate alcohol from other substances.</data>
      <data key="d3">chunk-31526a8f34a79f3f95e4cc8ce251e822</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763624493</data>
