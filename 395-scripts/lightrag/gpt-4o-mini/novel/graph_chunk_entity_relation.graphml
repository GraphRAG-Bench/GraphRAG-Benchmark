    <node id="Park Place Hotel">
      <data key="d0">Park Place Hotel</data>
      <data key="d1">organization</data>
      <data key="d2">Park Place Hotel was a prominent hotel in the city that was burned down in 1878 due to a fire believed to be caused by incendiaries.</data>
