    <node id="Cozumel">
      <data key="d0">Cozumel</data>
      <data key="d1">location</data>
      <data key="d2">Cozumel is an island near Yucatan, referenced as a location where people should ideally only die of old age or accident due to its healthiness.</data>
      <data key="d3">chunk-a838c08843884c0f3a0816d2b39bddaf</data>
