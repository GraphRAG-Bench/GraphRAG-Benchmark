    <node id="Buckeye Hill">
      <data key="d0">Buckeye Hill</data>
      <data key="d1">location</data>
      <data key="d2">Buckeye Hill is the location of the Summit House, indicating a geographical setting for the events described.&lt;SEP&gt;Buckeye Hill is the town where the Summit House is located.&lt;SEP&gt;Buckeye Hill is a community where the news of Mr. Bilson's marriage and Miss Trotter's new role at the hotel has caused a stir.</data>
      <data key="d3">chunk-369a75ce4a9aaf2cf4882dd927c2352f&lt;SEP&gt;chunk-61d5043e124aeb47926ce7d455548eaa&lt;SEP&gt;chunk-c9d2f3fca937ba86ebd935c1763ab116</data>
