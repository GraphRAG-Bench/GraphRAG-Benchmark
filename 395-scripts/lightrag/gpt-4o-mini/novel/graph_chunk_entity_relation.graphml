    </node>
    <node id="Joints">
      <data key="d0">Joints</data>
      <data key="d1">naturalobject</data>
      <data key="d2">Joints are articulated connections between bones, which allow movement and vary in structure as children grow.</data>
      <data key="d3">chunk-5ca6e973ad64937ab7bcd5ec67b32e10</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763624491</data>
      <data key="d6" />
    </node>
    <node id="Shoes">
      <data key="d0">Shoes</data>
      <data key="d1">artifact</data>
      <data key="d2">Shoes are footwear that can affect foot health, especially when they are tight or pinching, leading to various ailments.</data>
      <data key="d3">chunk-5ca6e973ad64937ab7bcd5ec67b32e10</data>
      <data key="d4">unknown_source</data>
