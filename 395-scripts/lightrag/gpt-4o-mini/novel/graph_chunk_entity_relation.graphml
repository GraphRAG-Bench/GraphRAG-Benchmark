    <node id="Old Man">
      <data key="d0">Old Man</data>
      <data key="d1">person</data>
      <data key="d2">The old man is a character who expresses awe towards the statue of Chaacmol and demonstrates respect in front of it.&lt;SEP&gt;The Old Man is a character who expresses deep concern about his son being influenced by a bad man named Perceval.</data>
      <data key="d3">chunk-f65c2b617b2b75df32a484e145b034fe&lt;SEP&gt;chunk-fc7c601f1a721e64645ccdb5e20b488f</data>
