    <node id="Proclamation">
      <data key="d0">Proclamation</data>
      <data key="d1">document</data>
      <data key="d2">The Proclamation issued by Durham explained his resignation and appealed to Canadian public opinion.</data>
      <data key="d3">chunk-1d3c806038738c5cf824708ed3cfff5e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763622253</data>
