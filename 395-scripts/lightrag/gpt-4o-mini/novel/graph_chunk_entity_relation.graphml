    <node id="Amrgar">
      <data key="d0">Amrgar</data>
      <data key="d1">person</data>
      <data key="d2">The Amrgar is the supreme chief of the Amazirghs, noted for his military renown against Imperial troops in 1819.</data>
      <data key="d3">chunk-11883b983a6b12419bdd608231cd321f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763626566</data>
