    </node>
    <node id="Mr. Ger-Falcon">
      <data key="d0">Mr. Ger-Falcon</data>
      <data key="d1">creature</data>
      <data key="d2">Mr. Ger-Falcon is a hawk who initially appears unfriendly but later shows gratitude for an invitation to stay with the hermit.</data>
      <data key="d3">chunk-be2d18b61665def22c8f765c51d5d1fb</data>
      <data key="d4">unknown_source</data>
