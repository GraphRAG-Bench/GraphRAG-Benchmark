    <node id="Liberal Arts">
      <data key="d0">Liberal Arts</data>
      <data key="d1">concept</data>
      <data key="d2">Liberal arts refer to the skills and subjects that Noah Carter believes should be valued, contrasting with the wealth of his rival.</data>
      <data key="d3">chunk-24655aa74002f9c9a1716299b6bb40bc</data>
      <data key="d4">unknown_source</data>
