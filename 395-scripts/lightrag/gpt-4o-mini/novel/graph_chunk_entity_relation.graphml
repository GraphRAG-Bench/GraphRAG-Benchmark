    </node>
    <node id="Lord John Russell">
      <data key="d0">Lord John Russell</data>
      <data key="d1">person</data>
      <data key="d2">Lord John Russell is mentioned as a supporter of Durham's policies in the House of Commons.</data>
      <data key="d3">chunk-1d3c806038738c5cf824708ed3cfff5e</data>
