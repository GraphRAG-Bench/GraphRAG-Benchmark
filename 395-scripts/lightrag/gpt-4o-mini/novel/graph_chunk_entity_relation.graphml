    </node>
    <node id="Melbourne Administration">
      <data key="d0">Melbourne Administration</data>
      <data key="d1">organization</data>
      <data key="d2">The Melbourne administration is referenced as the government that sent Durham to Canada and was expected to support him.</data>
      <data key="d3">chunk-1d3c806038738c5cf824708ed3cfff5e</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763622253</data>
