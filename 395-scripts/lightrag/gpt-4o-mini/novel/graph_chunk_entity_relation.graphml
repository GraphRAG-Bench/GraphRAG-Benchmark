      <data key="d0">Act of Indemnity</data>
      <data key="d1">legaldocument</data>
      <data key="d2">The Act of Indemnity is referenced as legislation passed to absolve those involved in executing Durham's ordinance.</data>
      <data key="d3">chunk-1d3c806038738c5cf824708ed3cfff5e</data>
      <data key="d4">unknown_source</data>
