    <node id="University">
      <data key="d0">University</data>
      <data key="d1">organization</data>
      <data key="d2">The University is a higher education institution that plans to integrate Queen Margaret and modify its degree offerings.&lt;SEP&gt;The University opened its doors to women medical students in 1916, reflecting a progressive shift in educational policies.</data>
      <data key="d3">chunk-8e1105db92c26143035157a3a806604b&lt;SEP&gt;chunk-64ab42f17996dafda93ff20305420aba</data>
