    <node id="Dixie">
      <data key="d0">Dixie</data>
      <data key="d1">song</data>
      <data key="d2">Dixie is a famous song composed by Dan Emmet, which became the national air of the Confederate States.&lt;SEP&gt;Dixie is a song practiced by musicians who performed at events surrounding the presidential election of 1860.</data>
      <data key="d3">chunk-fec55d764089631728870dee42955975&lt;SEP&gt;chunk-b6bd508a28ba32dd03863b08ac91bfa9</data>
