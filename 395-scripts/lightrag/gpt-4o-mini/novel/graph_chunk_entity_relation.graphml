    <node id="Mrs. D.">
      <data key="d0">Mrs. D.</data>
      <data key="d1">person</data>
      <data key="d2">Mrs. D. is a character who engages with Elsie about local politics and invites her to dinner.&lt;SEP&gt;Mrs. D. is a character noted for being present when the narrator returns home, implying a role in a social or familial context.</data>
      <data key="d3">chunk-f4dc7c9f3044941df1985ca230c24ea3&lt;SEP&gt;chunk-4384d56f7f67884c58051b580bac6f58</data>
