    <node id="Joe">
      <data key="d0">Joe</data>
      <data key="d1">person</data>
      <data key="d2">Joe is a boy who helps in retrieving the Fairfield children from the cold.&lt;SEP&gt;Joe is a character involved in a scenario where he uses a long switch to assist old Ned during a slide down the hill while drawing wood.</data>
      <data key="d3">chunk-08b9d6f937baa20d8292bac71db403dc&lt;SEP&gt;chunk-51ac45ec6721641ae16ac8fcb28ed74f</data>
