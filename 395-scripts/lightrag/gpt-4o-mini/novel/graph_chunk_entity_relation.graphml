    </node>
    <node id="Pitideb">
      <data key="d0">Pitideb</data>
      <data key="d1">location</data>
      <data key="d2">Pitideb, also known as Sitideb, is a town built by the Amazirghs, located on top of a high mountain and noted for its civilized inhabitants.</data>
      <data key="d3">chunk-11883b983a6b12419bdd608231cd321f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763626566</data>
