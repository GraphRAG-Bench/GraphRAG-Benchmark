    <node id="Central House">
      <data key="d0">Central House</data>
      <data key="d1">organization</data>
      <data key="d2">The Central House is one of the historical hotels that accommodated visitors during the era of steamboat travel.&lt;SEP&gt;Central House was the first hotel of any pretension in the city and one of the last to be destroyed by fire.</data>
      <data key="d3">chunk-2bf33d450055327352cd4545502529ee&lt;SEP&gt;chunk-6d6821bdddaee230e47cab021a16e7da</data>
