    <node id="Miss Jansen">
      <data key="d0">Miss Jansen</data>
      <data key="d1">person</data>
      <data key="d2">Miss Jansen is the woman whom Mr. Bilson is set to marry, influencing Miss Trotter's position at the hotel.&lt;SEP&gt;Miss Jansen is the woman whom Mr. Bilson is marrying, though she is not directly involved in the main narrative.</data>
      <data key="d3">chunk-369a75ce4a9aaf2cf4882dd927c2352f&lt;SEP&gt;chunk-343469de09660053c0e80621f41c713b</data>
      <data key="d4">unknown_source</data>
