    <node id="Sir Francis Bond Head">
      <data key="d0">Sir Francis Bond Head</data>
      <data key="d1">person</data>
      <data key="d2">Sir Francis Bond Head is the newly appointed lieutenant-governor whose instructions conflicted with Lord Gosford's approach to governance.</data>
