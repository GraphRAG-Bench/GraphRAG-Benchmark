      <data key="d0">Moorish Justice</data>
      <data key="d1">concept</data>
      <data key="d2">Moorish Justice refers to the legal system in Morocco, influenced by local customs and laws, impacting the treatment of foreign subjects.</data>
      <data key="d3">chunk-f9af5b64614e29079b8b6802af2587be</data>
      <data key="d4">unknown_source</data>
