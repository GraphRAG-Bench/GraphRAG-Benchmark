    </node>
    <node id="Au-yoeng">
      <data key="d0">Au-yoeng</data>
      <data key="d1">person</data>
      <data key="d2">Au-yoeng is a cormorant-fisher whose life becomes troubled due to bad luck and a theft incident.</data>
      <data key="d3">chunk-409131abbfafd74396f07aa2c2df7b16</data>
      <data key="d4">unknown_source</data>
