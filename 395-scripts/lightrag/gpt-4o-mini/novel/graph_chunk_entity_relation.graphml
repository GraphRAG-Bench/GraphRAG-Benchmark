    <node id="Temple">
      <data key="d0">Temple</data>
      <data key="d1">location</data>
      <data key="d2">The Temple is where the Holy Dragon is housed, guarded by priests and watchmen.&lt;SEP&gt;The Temple is a sacred space where the priests worship and where the Golden Dragon is returned.</data>
      <data key="d3">chunk-d1c80cac977c30ca82e1b9af698fb201&lt;SEP&gt;chunk-5dc6e32918330eb85b6be8174ed5395a</data>
