      <data key="d1">content</data>
      <data key="d2">Neue Hallische Gelehrte Zeitung was founded by Klotz in 1766 and edited by him and others until 1777.</data>
      <data key="d3">chunk-b00bff87303bf89315a4f5f9c478e3b5</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763621858</data>
