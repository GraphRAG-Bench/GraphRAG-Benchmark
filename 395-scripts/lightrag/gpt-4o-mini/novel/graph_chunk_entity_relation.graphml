    <node id="Jack">
      <data key="d0">Jack</data>
      <data key="d1">person</data>
      <data key="d2">Jack is a character who participates in a prospecting activity and has a romantic engagement with Tinka Jallinger.&lt;SEP&gt;Jack is a Cornishman credited in legend with killing the giant Cormoran.</data>
      <data key="d3">chunk-9c87d89cd1180b8d6a006229057edd6c&lt;SEP&gt;chunk-0acdfa773f8af706f91ebb20b7581863</data>
      <data key="d4">unknown_source</data>
