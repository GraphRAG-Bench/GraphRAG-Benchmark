    <node id="Headquarters">
      <data key="d0">Headquarters</data>
      <data key="d1">location</data>
      <data key="d2">Headquarters is an old cabin that serves as a social gathering place for the woodcutters and those fond of fun.</data>
      <data key="d3">chunk-029587962a0e769bf41beb4d2b181466</data>
      <data key="d4">unknown_source</data>
