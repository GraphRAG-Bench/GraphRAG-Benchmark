    <node id="Sons of Malta">
      <data key="d0">Sons of Malta</data>
      <data key="d1">organization</data>
      <data key="d2">The Sons of Malta is a secret order that was organized in the Eastern states and established a lodge in St. Paul.&lt;SEP&gt;The Sons of Malta is a secret organization noted for its unique initiation practices and events.</data>
      <data key="d3">chunk-009fdf8cbf7983837bf283e7b7bb7b52&lt;SEP&gt;chunk-d26c30cc3102d9679f3880d6b7c95b61&lt;SEP&gt;chunk-05ddaddeaf94d2bcd3da95a9c4f85c42</data>
