      <data key="d6" />
    </node>
    <node id="Wood Yard">
      <data key="d0">Wood Yard</data>
      <data key="d1">organization</data>
      <data key="d2">The wood yard is a business operation where wood is cut and sold, significant to the livelihoods of the characters involved.</data>
      <data key="d3">chunk-029587962a0e769bf41beb4d2b181466</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763624329</data>
