    <node id="Hammama">
      <data key="d0">Hammama</data>
      <data key="d1">tribe</data>
      <data key="d2">The Hammama is an Arab tribe mentioned in connection with the Sheikh Ali, known for deer-stalking.</data>
      <data key="d3">chunk-86994d5a5ba62d67eaecd5aaeeb5aab4</data>
      <data key="d4">unknown_source</data>
