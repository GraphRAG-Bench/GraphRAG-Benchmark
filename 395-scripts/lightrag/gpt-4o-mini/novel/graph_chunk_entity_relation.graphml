    <node id="Ceuta">
      <data key="d0">Ceuta</data>
      <data key="d1">location</data>
      <data key="d2">Ceuta, known as Esilissa in Ptolemy's time, is an ancient city positioned opposite Gibraltar.&lt;SEP&gt;Ceuta is a historical city located in North Africa, once inhabited by the Goths and later conquered by Arabs.</data>
      <data key="d3">chunk-c196bdb46661c725027c238489650eb3&lt;SEP&gt;chunk-026c31ea51debe67089624a49cd283a6</data>
