    <node id="Jewess">
      <data key="d0">Jewess</data>
      <data key="d1">person</data>
      <data key="d2">A loyal Jewish woman who is closely associated with the Consul's family, assisting them during their perilous situation.</data>
      <data key="d3">chunk-1c246ad7923d08e2ef2366af23b4c19f</data>
      <data key="d4">unknown_source</data>
