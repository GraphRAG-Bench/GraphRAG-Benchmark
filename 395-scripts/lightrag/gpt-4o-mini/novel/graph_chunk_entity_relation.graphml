    <node id="Republicanism">
      <data key="d0">Republicanism</data>
      <data key="d1">concept</data>
      <data key="d2">Republicanism is portrayed as a dominant political ideology in America, in contrast to Toryism.</data>
      <data key="d3">chunk-3fa1b94cc88676d252f09238e9d2fcd2</data>
