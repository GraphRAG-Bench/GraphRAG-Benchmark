      <data key="d0">Barbarossas</data>
      <data key="d1">person</data>
      <data key="d2">The Barbarossas refer to a notable family of pirates that allied with Andalusian cavaliers in Algiers to establish power.</data>
      <data key="d3">chunk-4cbd510e5f844be534e59040af85f777</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763626551</data>
