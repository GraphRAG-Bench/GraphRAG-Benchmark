    <node id="Brackett's Battalion">
      <data key="d0">Brackett's Battalion</data>
      <data key="d1">organization</data>
      <data key="d2">Brackett's Battalion comprised three Minnesota companies and was mustered into service during the Civil War by Capt. E.Y. Shelly.</data>
      <data key="d3">chunk-2a4789d4f1f7c874d43ac8b35b4ece9b</data>
      <data key="d4">unknown_source</data>
