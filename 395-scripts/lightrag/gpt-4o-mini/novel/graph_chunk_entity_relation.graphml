      <data key="d0">River Derna</data>
      <data key="d1">naturalobject</data>
      <data key="d2">The River Derna separates Tefza and Efza, serving as a geographical boundary between the two towns.</data>
      <data key="d3">chunk-11883b983a6b12419bdd608231cd321f</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763626566</data>
