    <node id="Toryism">
      <data key="d0">Toryism</data>
      <data key="d1">concept</data>
      <data key="d2">Toryism is a political ideology associated with conservative values and was considered to have limited influence in America.</data>
      <data key="d3">chunk-3fa1b94cc88676d252f09238e9d2fcd2</data>
      <data key="d4">unknown_source</data>
      <data key="d5">1763622255</data>
