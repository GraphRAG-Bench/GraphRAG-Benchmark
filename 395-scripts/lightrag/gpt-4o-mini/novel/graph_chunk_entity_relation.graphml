    <node id="Vandals">
      <data key="d0">Vandals</data>
      <data key="d1">organization</data>
      <data key="d2">The Vandals were a group that invaded and took control over North Africa, ruling for a century before being expelled by the Romans.</data>
      <data key="d3">chunk-4cbd510e5f844be534e59040af85f777</data>
      <data key="d4">unknown_source</data>
