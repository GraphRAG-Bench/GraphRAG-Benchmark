    <node id="Dr. Brown">
      <data key="d0">Dr. Brown</data>
      <data key="d1">person</data>
      <data key="d2">Dr. Brown is mentioned as a doctor who attended to the Sultan and was involved in an incident with the Vizier.&lt;SEP&gt;Dr. Brown attended the Sultan and experienced an encounter with the Vizier at the Maroquine Court.</data>
      <data key="d3">chunk-d8990e51d89971d42dec976410186259&lt;SEP&gt;chunk-2d2e2382323fa2c2ced43dc3587ea2a6</data>
