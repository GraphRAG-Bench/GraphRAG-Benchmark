    <node id="Mooress">
      <data key="d0">Mooress</data>
      <data key="d1">person</data>
      <data key="d2">Mooress refers to a Mauritanian woman described as extremely stout and unable to move.&lt;SEP&gt;Mooress is referred to as a Mauritanian Venus and is notably stout, requiring assistance to get up after falling down.</data>
      <data key="d3">chunk-d8990e51d89971d42dec976410186259&lt;SEP&gt;chunk-8a3a39ae3aa8492d1ce85349e33fe6e9</data>
