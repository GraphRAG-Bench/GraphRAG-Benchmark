    <node id="House of Lords">
      <data key="d0">House of Lords</data>
      <data key="d1">location</data>
      <data key="d2">The House of Lords is referenced as the location where debates and criticisms against Durham's actions took place.</data>
      <data key="d3">chunk-1d3c806038738c5cf824708ed3cfff5e</data>
      <data key="d4">unknown_source</data>
