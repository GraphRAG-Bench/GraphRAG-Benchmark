    <node id="Holy Dragon">
      <data key="d0">Holy Dragon</data>
      <data key="d1">artifact</data>
      <data key="d2">The Holy Dragon is a magnificent idol made of gold and adorned with precious stones, which is lightweight despite its large size.</data>
      <data key="d3">chunk-d1c80cac977c30ca82e1b9af698fb201</data>
      <data key="d4">unknown_source</data>
