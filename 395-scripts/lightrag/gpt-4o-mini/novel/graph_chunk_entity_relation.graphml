    <node id="Jallinger">
      <data key="d0">Jallinger</data>
      <data key="d1">person</data>
      <data key="d2">Jallinger is a recluse religious hunter and the father of Tinka Jallinger, who is skeptical of miners and holds a secret prospecting interest.</data>
      <data key="d3">chunk-9c87d89cd1180b8d6a006229057edd6c</data>
